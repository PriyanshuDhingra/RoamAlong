{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gateway",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "backend.gateway.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "backend",
        "--reload-dir",
        "apps"
      ],
      "port": 8000
    },
    {
      "name": "metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081",
        "--clear"
      ],
      "cwd": "apps/mobile",
      "port": 8081
    },
    {
      "name": "roamalong-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx/esm",
        "server/index.ts"
      ],
      "port": 3000
    },
    {
      "name": "roamalong-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "0.0.0.0",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "roamalong-metro",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_WEB_URL=https://beings-replace-avenue-try.trycloudflare.com",
        "npx",
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081
    }
  ]
}
