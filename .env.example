# Copy to .env and fill in. Never commit .env.

# Boson AI (Higgs Realtime, TTS, voice cloning)
BOSON_API_KEY=
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime?model=higgs-realtime
# Set after cloning a guide voice (POST /v1/audio/voices); "default" otherwise
BOSON_GUIDE_VOICE=default

# Azure OpenAI (Director, rolling summary, router fallback, offline card generation)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=

# Optional: live "open now" / ratings (§10.6). Leave empty to use OSM + Wikivoyage + web_search only.
GOOGLE_PLACES_API_KEY=

# Database (docker-compose service "db")
POSTGRES_USER=wander
POSTGRES_PASSWORD=wander
POSTGRES_DB=wander
DATABASE_URL=postgresql://wander:wander@localhost:5432/wander

# Routing (docker-compose service "valhalla")
VALHALLA_URL=http://localhost:8002
# OSM extract Valhalla builds tiles from: BBBike's Toronto extract (~100 MB, fast to build). For all of Ontario use
# https://download.geofabrik.de/north-america/canada/ontario-latest.osm.pbf
VALHALLA_TILE_URL=https://download.bbbike.org/osm/bbbike/Toronto/Toronto.osm.pbf

# Contact string sent as User-Agent to Overpass / Wikidata / Wikipedia (their policies ask for one)
WANDER_CONTACT=wander-hackathon (https://github.com/PriyanshuDhingra/realtime-conversation-walking-guide)
