# Copy to .env and fill in. Never commit .env.

# Boson AI (Higgs Realtime, TTS, voice cloning)
BOSON_API_KEY=
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime?model=higgs-realtime

# Azure OpenAI research agents. ENDPOINT must be the Responses API URL ending in /responses.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Story database. Research is stored here and reused after a restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
