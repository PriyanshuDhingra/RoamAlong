# Copy to .env and fill in. Never commit .env.

# Boson AI (Higgs Realtime, TTS, voice cloning)
BOSON_API_KEY=
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime?model=higgs-realtime
# Set after cloning a guide voice (POST /v1/audio/voices); "default" otherwise
BOSON_GUIDE_VOICE=default

# Azure OpenAI (Director, rolling summary, router fallback, offline card generation)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=

# Story database. Research is stored here and reused after a restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: live "open now" / ratings (§10.6). Leave empty to use OSM + Wikivoyage + web_search only.
GOOGLE_PLACES_API_KEY=

# Contact string sent as User-Agent to Overpass / Wikidata / Wikipedia (their policies ask for one)
WANDER_CONTACT=wander-hackathon (https://github.com/PriyanshuDhingra/realtime-conversation-walking-guide)
