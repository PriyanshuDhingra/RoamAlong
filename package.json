{
  "name": "handheld-boson-audio-tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-entry.js",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --import tsx/esm --watch server/index.ts",
    "dev:web": "vite",
    "dev:expo": "node --import tsx/esm tools/expoTunnel.ts",
    "dev:expo:tunnel": "node --import tsx/esm tools/expoTunnel.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "node --import tsx/esm tools/probe.ts"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-location": "~58.0.19",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^6.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
