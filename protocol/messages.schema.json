{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wander.app/protocol/messages.schema.json",
  "title": "WanderProtocol",
  "description": "App <-> Gateway JSON text frames (IMPLEMENTATION_PLAN.md §3.4). Binary audio frames are described in protocol/README.md. Single source of truth: edit this file, then run protocol/generate.sh.",
  "type": "object",
  "properties": {
    "uplink": {
      "$ref": "#/definitions/UplinkMessage"
    },
    "downlink": {
      "$ref": "#/definitions/DownlinkMessage"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "UplinkMessage": {
      "title": "UplinkMessage",
      "description": "App -> Gateway",
      "oneOf": [
        {
          "$ref": "#/definitions/Hello"
        },
        {
          "$ref": "#/definitions/Location"
        },
        {
          "$ref": "#/definitions/Playback"
        },
        {
          "$ref": "#/definitions/Control"
        },
        {
          "$ref": "#/definitions/Ui"
        },
        {
          "$ref": "#/definitions/Text"
        }
      ]
    },
    "DownlinkMessage": {
      "title": "DownlinkMessage",
      "description": "Gateway -> App",
      "oneOf": [
        {
          "$ref": "#/definitions/Ready"
        },
        {
          "$ref": "#/definitions/StopPlayback"
        },
        {
          "$ref": "#/definitions/Transcript"
        },
        {
          "$ref": "#/definitions/MapFocus"
        },
        {
          "$ref": "#/definitions/Card"
        },
        {
          "$ref": "#/definitions/Route"
        },
        {
          "$ref": "#/definitions/NavCue"
        },
        {
          "$ref": "#/definitions/State"
        },
        {
          "$ref": "#/definitions/Tour"
        },
        {
          "$ref": "#/definitions/Debug"
        },
        {
          "$ref": "#/definitions/Error"
        }
      ]
    },
    "Mode": {
      "title": "Mode",
      "type": "string",
      "enum": [
        "wander",
        "tour"
      ]
    },
    "GuideState": {
      "title": "GuideState",
      "description": "Conversation state machine (§7.0)",
      "type": "string",
      "enum": [
        "LISTENING",
        "ANSWERING",
        "NARRATING",
        "NAV_CUE",
        "WAITING_FOR_USER",
        "WAITING_FOR_DATA",
        "IDLE",
        "QUIET"
      ]
    },
    "Proactivity": {
      "title": "Proactivity",
      "type": "string",
      "enum": [
        "quiet",
        "follow_my_lead",
        "balanced",
        "chatty"
      ]
    },
    "LocationSource": {
      "title": "LocationSource",
      "type": "string",
      "enum": [
        "gps",
        "sim"
      ]
    },
    "EntityKind": {
      "title": "EntityKind",
      "type": "string",
      "enum": [
        "building",
        "artwork",
        "monument",
        "park",
        "tree",
        "street",
        "intersection",
        "area",
        "river",
        "shoreline",
        "venue",
        "food",
        "plaque",
        "transit",
        "other"
      ]
    },
    "FocusStyle": {
      "title": "FocusStyle",
      "type": "string",
      "enum": [
        "building",
        "area",
        "street",
        "point",
        "path"
      ]
    },
    "ClaimType": {
      "title": "ClaimType",
      "type": "string",
      "enum": [
        "established",
        "contested",
        "folklore"
      ]
    },
    "LineString": {
      "title": "LineString",
      "description": "GeoJSON LineString, [lon, lat] order",
      "type": "object",
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 3
          },
          "minItems": 2
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "Hello": {
      "title": "Hello",
      "description": "First message on a new connection",
      "type": "object",
      "properties": {
        "type": {
          "const": "hello"
        },
        "device_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/Mode"
        },
        "tour_id": {
          "type": "string"
        },
        "ui_lang": {
          "type": "string",
          "description": "BCP 47, e.g. en, fr-CA"
        },
        "app_version": {
          "type": "string"
        },
        "debug": {
          "type": "boolean",
          "default": false
        },
        "resume_token": {
          "type": "string",
          "description": "Set when reconnecting to keep the Gateway session (§14.4)"
        }
      },
      "required": [
        "type",
        "device_id",
        "mode",
        "ui_lang",
        "app_version"
      ],
      "additionalProperties": false
    },
    "Location": {
      "title": "Location",
      "description": "1 Hz, more often on large changes",
      "type": "object",
      "properties": {
        "type": {
          "const": "location"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracy_m": {
          "type": "number",
          "minimum": 0
        },
        "heading_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "Device compass"
        },
        "course_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "Course over ground"
        },
        "speed_mps": {
          "type": "number",
          "minimum": 0
        },
        "ts": {
          "type": "number",
          "description": "Unix epoch milliseconds"
        },
        "source": {
          "$ref": "#/definitions/LocationSource"
        }
      },
      "required": [
        "type",
        "lat",
        "lon",
        "accuracy_m",
        "ts",
        "source"
      ],
      "additionalProperties": false
    },
    "Playback": {
      "title": "Playback",
      "description": "Every 250 ms while playing, and on local stop",
      "type": "object",
      "properties": {
        "type": {
          "const": "playback"
        },
        "item_id": {
          "type": "string"
        },
        "played_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stopped": {
          "type": "boolean",
          "default": false,
          "description": "True when playback of this item stopped locally (barge-in, cancel)"
        }
      },
      "required": [
        "type",
        "item_id",
        "played_ms"
      ],
      "additionalProperties": false
    },
    "Control": {
      "title": "Control",
      "type": "object",
      "properties": {
        "type": {
          "const": "control"
        },
        "action": {
          "type": "string",
          "enum": [
            "mute_mic",
            "unmute_mic",
            "pause_guide",
            "resume_guide",
            "ptt_down",
            "ptt_up",
            "set_mode"
          ],
          "description": "set_mode requires mode"
        },
        "mode": {
          "$ref": "#/definitions/Mode"
        }
      },
      "required": [
        "type",
        "action"
      ],
      "additionalProperties": false
    },
    "Ui": {
      "title": "Ui",
      "description": "Taps become context for the guide",
      "type": "object",
      "properties": {
        "type": {
          "const": "ui"
        },
        "action": {
          "type": "string",
          "enum": [
            "tap_entity",
            "tap_map",
            "start_tour",
            "stop_nav",
            "end_tour",
            "skip_stop"
          ]
        },
        "entity_id": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "tour_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "action"
      ],
      "additionalProperties": false
    },
    "Text": {
      "title": "Text",
      "description": "Typed user input (debug client, mic-off fallback)",
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "Ready": {
      "title": "Ready",
      "type": "object",
      "properties": {
        "type": {
          "const": "ready"
        },
        "session_id": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/Mode"
        },
        "resume_token": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "session_id",
        "voice",
        "mode"
      ],
      "additionalProperties": false
    },
    "StopPlayback": {
      "title": "StopPlayback",
      "description": "Flush the playback queue immediately",
      "type": "object",
      "properties": {
        "type": {
          "const": "stop_playback"
        },
        "reason": {
          "type": "string",
          "enum": [
            "barge_in",
            "cancel"
          ]
        },
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Items whose remaining audio must be dropped; empty = all"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    },
    "Transcript": {
      "title": "Transcript",
      "type": "object",
      "properties": {
        "type": {
          "const": "transcript"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "item_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "final": {
          "type": "boolean"
        },
        "lang": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "role",
        "item_id",
        "text",
        "final"
      ],
      "additionalProperties": false
    },
    "FocusEntity": {
      "title": "FocusEntity",
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "description": "Resolved DB id, never a spoken name"
        },
        "kind": {
          "$ref": "#/definitions/EntityKind"
        },
        "geometry_ref": {
          "type": "string",
          "description": "Key of geometry already pushed to the app"
        },
        "label": {
          "type": "string"
        },
        "badge": {
          "type": "string",
          "description": "A/B badge for ambiguity candidates"
        }
      },
      "required": [
        "entity_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "MapFocus": {
      "title": "MapFocus",
      "description": "Highlight what is being talked about, synced to speech (§12.3)",
      "type": "object",
      "properties": {
        "type": {
          "const": "map_focus"
        },
        "focus_id": {
          "type": "string"
        },
        "response_id": {
          "type": "string"
        },
        "item_id": {
          "type": "string",
          "description": "Audio item t_start_ms is relative to"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FocusEntity"
          }
        },
        "style": {
          "$ref": "#/definitions/FocusStyle"
        },
        "camera": {
          "type": "string",
          "enum": [
            "fit",
            "keep"
          ]
        },
        "t_start_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "focus_id",
        "response_id",
        "entities",
        "style",
        "camera"
      ],
      "additionalProperties": false
    },
    "CardFact": {
      "title": "CardFact",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/definitions/ClaimType"
        },
        "source_title": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "description": "For time-bound items: freshness shown in the sheet"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "Card": {
      "title": "Card",
      "description": "Bottom caption chip",
      "type": "object",
      "properties": {
        "type": {
          "const": "card"
        },
        "entity_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "thumb_url": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CardFact"
          },
          "maxItems": 5
        }
      },
      "required": [
        "type",
        "entity_id",
        "title",
        "facts"
      ],
      "additionalProperties": false
    },
    "Maneuver": {
      "title": "Maneuver",
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "instruction": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "distance_m": {
          "type": "number",
          "description": "Length of the leg after this maneuver"
        },
        "street_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "landmark_entity_id": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "instruction",
        "lat",
        "lon",
        "distance_m"
      ],
      "additionalProperties": false
    },
    "Route": {
      "title": "Route",
      "type": "object",
      "properties": {
        "type": {
          "const": "route"
        },
        "route_id": {
          "type": "string"
        },
        "geojson": {
          "$ref": "#/definitions/LineString"
        },
        "maneuvers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Maneuver"
          }
        },
        "eta_s": {
          "type": "number",
          "minimum": 0
        },
        "cleared": {
          "type": "boolean",
          "default": false,
          "description": "True = navigation stopped, remove the route"
        }
      },
      "required": [
        "type",
        "route_id",
        "geojson",
        "maneuvers",
        "eta_s"
      ],
      "additionalProperties": false
    },
    "NavCue": {
      "title": "NavCue",
      "description": "Haptic + earcon on the phone",
      "type": "object",
      "properties": {
        "type": {
          "const": "nav_cue"
        },
        "maneuver_idx": {
          "type": "integer",
          "minimum": 0
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "earcon": {
          "type": "string",
          "enum": [
            "turn_soon",
            "turn_now",
            "arrived",
            "off_route"
          ]
        }
      },
      "required": [
        "type",
        "maneuver_idx",
        "distance_m",
        "earcon"
      ],
      "additionalProperties": false
    },
    "TourStop": {
      "title": "TourStop",
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "done",
            "current",
            "upcoming"
          ]
        }
      },
      "required": [
        "entity_id",
        "name",
        "lat",
        "lon",
        "status"
      ],
      "additionalProperties": false
    },
    "Tour": {
      "title": "Tour",
      "description": "Guided tour progress (§8); sent on start, arrival, each new leg and end",
      "type": "object",
      "properties": {
        "type": {
          "const": "tour"
        },
        "tour_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "ended"
          ]
        },
        "current": {
          "type": "integer",
          "minimum": 0
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TourStop"
          }
        },
        "leg_eta_min": {
          "type": [
            "integer",
            "null"
          ]
        },
        "leg_distance_m": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "tour_id",
        "title",
        "status",
        "current",
        "stops"
      ],
      "additionalProperties": false
    },
    "State": {
      "title": "State",
      "type": "object",
      "properties": {
        "type": {
          "const": "state"
        },
        "mode": {
          "$ref": "#/definitions/Mode"
        },
        "guide_state": {
          "$ref": "#/definitions/GuideState"
        },
        "language": {
          "type": "string"
        },
        "proactivity": {
          "$ref": "#/definitions/Proactivity"
        }
      },
      "required": [
        "type",
        "mode",
        "guide_state",
        "language",
        "proactivity"
      ],
      "additionalProperties": false
    },
    "Debug": {
      "title": "Debug",
      "description": "Only sent when hello.debug=true",
      "type": "object",
      "properties": {
        "type": {
          "const": "debug"
        },
        "kind": {
          "type": "string",
          "description": "e.g. director_decision, attention_queue, event"
        },
        "ts": {
          "type": "number"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "kind",
        "payload"
      ],
      "additionalProperties": false
    },
    "Error": {
      "title": "Error",
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "auth",
            "billing",
            "upstream_busy",
            "upstream_unavailable",
            "bad_message",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        },
        "fatal": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "fatal"
      ],
      "additionalProperties": false
    }
  }
}
